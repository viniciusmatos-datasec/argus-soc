# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env — ele já está no .gitignore.

# --- API (FastAPI) ---
API_SECRET_KEY=troque-por-uma-chave-secreta-aleatoria
API_JWT_ALGORITHM=HS256
API_JWT_EXPIRATION_MINUTES=60

# --- LLM Analyst ---
# Chave da API do provedor de LLM usado para resumir/recomendar ações sobre incidentes
LLM_API_KEY=sua-chave-aqui
LLM_MODEL=claude-sonnet-5

# --- Cloud (AWS) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Cloud (Azure) ---
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# --- Cloud (GCP) ---
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json
GCP_PROJECT_ID=

# --- SIEM / TheHive ---
THEHIVE_URL=http://localhost:9000
THEHIVE_API_KEY=

# --- Notificações (SOAR) ---
SLACK_WEBHOOK_URL=

# --- DVC (remote) ---
DVC_REMOTE_URL=
